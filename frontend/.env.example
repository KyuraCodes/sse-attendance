# ==============================================================================
# Supabase Cloud Database Configuration Template
# Copy this file to .env or .env.local and fill in your actual credentials.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Application Security
JWT_SECRET=your-secure-jwt-secret
NEXT_PUBLIC_API_URL=
